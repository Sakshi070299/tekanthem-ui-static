# ── Public (exposed to browser bundle) ──────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Server-only: Office 365 SMTP for contact & callback forms ───────
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=sales_website@tekanthem.com
SMTP_PASSWORD=your-app-password-here
SMTP_FROM_NAME=Sales website
SMTP_FROM_EMAIL=sales_website@tekanthem.com

# Where form submissions get delivered
CONTACT_INBOX_EMAIL=system@tekanthem.com
